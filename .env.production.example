# Coolify の環境変数にコピーする本番用の雛形。値はプレースホルダ。
# NODE_ENV はイメージが production に設定する。PORT は Coolify の Ports Exposes が注入する。

APP_ID=app
# https のオリジン（パスなし）。localhost は不可。APP_ORIGIN と AUTH_ORIGIN は別ホスト。
APP_ORIGIN=https://app.example.com
AUTH_ORIGIN=https://auth.example.com

# 参加アプリ用ロール。列権限は認証サーバーの planning/participant/participant-access.sql
DATABASE_URL="postgresql://app_participant:replace-me@db-host:5432/database_name?schema=public"

# 参加アプリ共通の Redis ユーザー。認証サーバーの PARTICIPANT_REDIS_PASSWORD と同じパスワード
REDIS_URL="redis://app_participant:replace-me@redis-host:6379/"
# REDIS_KEY_PREFIX=
# SESSION_MAX_AGE_SECONDS=2592000
