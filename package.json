{
  "name": "astro-webauthn-app",
  "description": "Participant app that verifies session handoff from a WebAuthn authentication server",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pnpm run env:check:build",
    "preview": "astro preview",
    "start": "node ./dist/server/entry.mjs",
    "format": "prettier -w .",
    "lint": "eslint .",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:integration": "vitest run --project integration",
    "test:all": "vitest run --project unit && vitest run --project integration",
    "db:ensure-test": "node scripts/ensure-test-db.mjs",
    "db:generate": "prisma generate",
    "env:check:build": "esbuild src/server/env-check.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/env-check.mjs"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.7",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "astro": "^7.3.7",
    "dotenv": "^18.0.6",
    "hono": "^4.13.13",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1",
    "prisma": "^7.10.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@typescript-eslint/parser": "^8.71.1",
    "astro-eslint-parser": "^3.2.0",
    "esbuild": "0.28.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
