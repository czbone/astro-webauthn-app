---
interface Props {
  title: string
}

const { title } = Astro.props
import '@/styles/global.css'

import LogoutForm from '@/components/LogoutForm.astro'
import { canManageAppRoles, canViewGrants } from '@/server/auth/permission'

const access = Astro.locals.access
const hasSession = access.kind === 'ok' || access.kind === 'no-grant'
const showGrants = access.kind === 'ok' && canViewGrants(access.user.role)
const showRoles = access.kind === 'ok' && canManageAppRoles(access.user.role)
Astro.response.headers.set('Cache-Control', 'no-store')
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class="bg-gray-50 text-gray-900">
    <header class="border-b border-gray-200 bg-white">
      <nav class="mx-auto flex max-w-3xl items-center justify-between px-4 py-4">
        <a class="text-lg font-semibold" href="/">
          参加アプリ
        </a>
        <div class="flex items-center gap-4 text-sm">
          {showGrants && (
            <a class="text-blue-700 underline" href="/grants">
              利用許可の例外
            </a>
          )}
          {showRoles && (
            <a class="text-blue-700 underline" href="/roles">
              アプリ内ロール
            </a>
          )}
          {hasSession ? (
            <LogoutForm />
          ) : (
            <a
              class="rounded-md bg-gray-900 px-4 py-2 font-medium text-white hover:bg-gray-700"
              href="/"
            >
              ログイン
            </a>
          )}
        </div>
      </nav>
    </header>
    <main class="mx-auto max-w-3xl px-4 py-10">
      <slot />
    </main>
  </body>
</html>
