---
interface Props {
  title: string
}

const { title } = Astro.props
import '@/styles/global.css'

const access = Astro.locals.access
const showGrants = access.kind === 'ok' && access.permission === 'admin'
Astro.response.headers.set('Cache-Control', 'no-store')
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class="bg-gray-50 text-gray-900">
    <header class="border-b border-gray-200 bg-white">
      <nav class="mx-auto flex max-w-3xl items-center justify-between px-4 py-4">
        <a class="text-lg font-semibold" href="/">
          参加アプリ
        </a>
        {showGrants && (
          <a class="text-sm text-blue-700 underline" href="/grants">
            付与一覧
          </a>
        )}
      </nav>
    </header>
    <main class="mx-auto max-w-3xl px-4 py-10">
      <slot />
    </main>
  </body>
</html>
