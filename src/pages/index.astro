---
import Layout from '@/layouts/MainLayout.astro'
import Denied from '@/components/Denied.astro'
import LogoutForm from '@/components/LogoutForm.astro'
import { permissionLabel } from '@/server/auth/permission'

const access = Astro.locals.access
if (access.kind === 'public') throw new Error('画面の権限が解決されていません')

const profile =
  access.kind === 'ok'
    ? {
        email: access.user.email,
        name: access.user.name,
        permission: permissionLabel(access.permission),
        admin: access.permission === 'admin'
      }
    : null

if (!profile) Astro.response.status = 403
---

<Layout title={profile ? 'ホーム' : '権限がありません'}>
  {profile ? (
    <section>
      <h1 class="text-2xl font-semibold">ログイン中</h1>
      <dl class="mt-6 space-y-3">
        <div>
          <dt class="text-sm text-gray-500">メールアドレス</dt>
          <dd>{profile.email}</dd>
        </div>
        <div>
          <dt class="text-sm text-gray-500">名前</dt>
          <dd>{profile.name}</dd>
        </div>
        <div>
          <dt class="text-sm text-gray-500">権限</dt>
          <dd>{profile.permission}</dd>
        </div>
      </dl>
      {profile.admin && (
        <p class="mt-6">
          <a class="text-blue-700 underline" href="/grants">
            付与一覧
          </a>
        </p>
      )}
      <div class="mt-8">
        <LogoutForm />
      </div>
    </section>
  ) : (
    <Denied message="このアプリを利用する権限がありません" logout />
  )}
</Layout>
