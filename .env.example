APP_ID=app
APP_ORIGIN=http://app.localhost:4000
AUTH_ORIGIN=http://auth.localhost:3000

# 参加アプリ用ロール。列権限は認証サーバーの planning/participant/participant-access.sql
DATABASE_URL="postgresql://app_participant:replace-me@localhost:5432/database_name?schema=public"

# 参加アプリ共通の Redis ユーザー。認証サーバーの PARTICIPANT_REDIS_PASSWORD と同じパスワード
REDIS_URL="redis://app_participant:replace-me@localhost:6379/"
# REDIS_KEY_PREFIX=
# SESSION_MAX_AGE_SECONDS=2592000

# 統合テスト用の専用データベース。DATABASE_URL とは別のデータベースにする
# 未作成なら pnpm db:ensure-test
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/astro_webauthn_app_test?schema=public"
# フィクスチャ投入用。未設定時は redis://localhost:6379/
# SET と ACL SETUSER ができるユーザーが要る
# TEST_REDIS_URL="redis://localhost:6379/"
